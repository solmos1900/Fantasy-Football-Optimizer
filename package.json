{
  "name": "gridiron-iq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy-retry.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "verify:defense": "tsx scripts/verify-defense-matchups.ts",
    "verify:guest": "tsx scripts/verify-guest-entry.ts",
