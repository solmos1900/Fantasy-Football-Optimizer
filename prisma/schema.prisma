generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt hash for email/password credentials (null for OAuth / guest)
  passwordHash  String?
  /// Temporary try-without-account session user
  isGuest       Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  leagues       LeagueConnection[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LeagueConnection {
  id              String   @id @default(cuid())
  userId          String
  leagueId        String
  season          Int
  teamId          Int?
  leagueName      String?
  isDemo          Boolean  @default(false)
  espnSwid        String?
  espnS2          String?
  lastSyncedAt    DateTime?
  cachedPayload   String?  // JSON snapshot of normalized league data
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, leagueId, season])
  @@index([userId])
}

/// Weekly projected vs actual PPR (and optional usage) for trend analysis.
/// Populated on league sync / insights refresh from ESPN league scoring or demo seed.
/// Source is never a paid feed unless one is wired — see docs/projections-and-trends.md.
model PlayerProjectionSnapshot {
  id           String   @id @default(cuid())
  espnId       Int
  playerName   String
  position     String
  nflTeam      String?
  season       Int
  week         Int
  /// ESPN (or demo) projected PPR for that week; null if unknown at capture time
  projectedPpr Float?
  /// Actual league-scoring / PPR points when the week is complete (or in progress)
  actualPpr    Float?
  /// Optional usage proxies when ESPN stats expose them (may stay null)
  targets      Float?
  carries      Float?
  targetShare  Float?
  /// espn | demo | heuristic — never invent third-party brand labels
  source       String   @default("espn")
  /// League scope so multi-league users keep separate histories ("" = global/demo fallback)
  leagueId     String   @default("")
  opponent     String?
  capturedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([espnId, season, week, leagueId])
  @@index([espnId, season])
  @@index([leagueId, season, week])
}

/// Rolling trend metrics derived from PlayerProjectionSnapshot rows.
model PlayerTrendMetric {
  id              String   @id @default(cuid())
  espnId          Int
  playerName      String
  position        String
  season          Int
  leagueId        String   @default("")
  weeksSampled    Int      @default(0)
  avgProjected    Float?
  avgActual       Float?
  /// Mean (actual − projected) over weeks with both values
  avgDelta        Float?
  recentFormAvg   Float?
  /// hot | cold | boom | bust | rising | falling | steady | thin
  trendLabel      String   @default("thin")
  /// rising | falling | steady | unknown — based on recent actuals slope when available
  usageTrend      String   @default("unknown")
  /// Additive PPR chip adjustment for trade valuing (can be negative)
  restOfSeasonAdj Float    @default(0)
  rationale       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([espnId, season, leagueId])
  @@index([espnId, season])
  @@index([leagueId, season, trendLabel])
}
