# ── Database (PostgreSQL) ─────────────────────────────────
# Local (Docker): docker compose up -d postgres
DATABASE_URL="postgresql://gridiron:gridiron@localhost:5432/gridiron_iq?schema=public"
#
# Vercel / Neon: use the pooled connection string from the dashboard.
# Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
# For serverless, prefer the pooler URL (often includes -pooler in the host).

# ── Auth.js (NextAuth v5) ─────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Required behind Vercel / reverse proxies (also set trustHost: true in code)
AUTH_TRUST_HOST="true"
# Production canonical URL (set on Vercel for the live deployment)
# AUTH_URL="https://gridiron-iq-app-alpha.vercel.app"
# Local:
# AUTH_URL="http://localhost:3000"

# Google OAuth — optional. Email/password + Guest work without these.
# https://console.cloud.google.com/apis/credentials
# Authorized redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Aliases also accepted:
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub OAuth — optional. Email/password + Guest work without these.
# https://github.com/settings/developers
# Authorization callback: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Aliases also accepted:
# GITHUB_ID=""
# GITHUB_SECRET=""

# ── ESPN Fantasy ──────────────────────────────────────────
# Season year for new connections (NFL fantasy season start year)
DEFAULT_ESPN_SEASON="2026"
# Client form default (should match DEFAULT_ESPN_SEASON)
NEXT_PUBLIC_DEFAULT_SEASON="2026"

# Private leagues need browser cookies from fantasy.espn.com while logged in:
#   1. Open DevTools → Application → Cookies → https://fantasy.espn.com
#   2. Copy SWID (includes braces, e.g. {ABC-123-...})
#   3. Copy espn_s2 (long encoded string — keep URL encoding)
# Enter those in the Connect League form; they are stored per-user in the DB.
# Public leagues work with league ID + season only (no cookies).
#
# Defense comps use league completed-week PPR from the ESPN fantasy sync plus
# opponent labels from ESPN's public NFL scoreboard (no extra API key):
#   https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard
# Fabricated / seed comps are never used for live leagues.

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Gridiron IQ"
